// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String   @unique
  role      String   @default("ADMIN") // Role: ADMIN, MEMBER
  createdAt DateTime @default(now())
}

model Member {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  fullName          String
  phone             String
  address           String?
  note              String?
  bankName          String?      // Tên ngân hàng
  bankAccountNumber String?      // Số tài khoản
  huiMembers        HuiMember[]
  payments          Payment[]
  createdAt         DateTime     @default(now())
}

model HuiGroup {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  amount           Float        // Mệnh giá hụi
  cycle            String       @default("MONTHLY") // Cycle: DAILY, WEEKLY, MONTHLY, CUSTOM...
  maxBidPercentage Float        @default(10) // Giới hạn mức kêu tối đa (%)
  totalSlots       Int          // Tổng số phần (chân hụi)
  startDate        DateTime
  status           String       @default("OPEN") // HuiStatus: OPEN, RUNNING, FINISHED
  huiMembers       HuiMember[]
  sessions         HuiSession[]
  createdAt        DateTime     @default(now())
}

model HuiMember {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  huiGroupId String   @db.ObjectId
  huiGroup   HuiGroup @relation(fields: [huiGroupId], references: [id], onDelete: Cascade)
  memberId   String   @db.ObjectId
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  slots      Int      @default(1)
}

model HuiSession {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  huiGroupId           String    @db.ObjectId
  huiGroup             HuiGroup  @relation(fields: [huiGroupId], references: [id], onDelete: Cascade)
  sessionNumber        Int
  openDate             DateTime  @default(now())
  winnerMemberId       String?   @db.ObjectId
  bidAmount            Float     @default(0) // Giá bỏ thăm
  winnerReceivedAmount Float     @default(0) // Thực nhận
  status               String    @default("PENDING") // SessionStatus: PENDING, DONE
  payments             Payment[]
}

model Payment {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String     @db.ObjectId
  session     HuiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId    String     @db.ObjectId
  member      Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  isDead      Boolean    @default(false) // Hụi chết/sống
  amountToPay Float
  paidStatus  String     @default("UNPAID") // PaidStatus: UNPAID, PAID
  paidAt      DateTime?
}
