// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  phone             String       @unique
  password          String       // Hashed password
  fullName          String
  role              String       @default("MEMBER") // Role: ADMIN, MEMBER
  avatar            String?      // Biểu tượng mặt người / emoji đại diện
  address           String?
  note              String?
  bankName          String?      // Tên ngân hàng
  bankAccountNumber String?      // Số tài khoản
  huiMembers        HuiMember[]
  payments          Payment[]
  bids              Bid[]
  transfersSent     TransferHistory[] @relation("FromUser")
  transfersReceived TransferHistory[] @relation("ToUser")
  createdAt         DateTime     @default(now())
}

model HuiGroup {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  amount           Float        // Mệnh giá hụi
  cycle            String       @default("MONTHLY") // Cycle: DAILY, WEEKLY, MONTHLY, CUSTOM...
  biddingDays      String?      // Các ngày khui hụi tùy chọn (VD: "5, 20")
  isPublic         Boolean      @default(false) // Công khai cho mọi người tự tham gia
  maxBidPercentage Float        @default(10) // Giới hạn mức kêu tối đa (%)
  totalSlots       Int          // Tổng số phần (chân hụi)
  startDate        DateTime
  status           String       @default("OPEN") // HuiStatus: OPEN, RUNNING, FINISHED
  huiMembers        HuiMember[]
  sessions         HuiSession[]
  transferHistories TransferHistory[]
  createdAt        DateTime     @default(now())
}

model HuiMember {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  huiGroupId String   @db.ObjectId
  huiGroup   HuiGroup @relation(fields: [huiGroupId], references: [id], onDelete: Cascade)
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots      Int      @default(1) // (Không còn dùng nữa, thay bằng nhiều record HuiMember)
  name       String?  // Tên chân hụi (VD: Chân 1, Chân 2)
  bids       Bid[]
  payments   Payment[]
  createdAt  DateTime @default(now())
}

model HuiSession {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  huiGroupId           String    @db.ObjectId
  huiGroup             HuiGroup  @relation(fields: [huiGroupId], references: [id], onDelete: Cascade)
  sessionNumber        Int
  openDate             DateTime  @default(now())
  winnerUserId         String?   @db.ObjectId // (Giữ lại để tương thích ngược)
  winnerMemberId       String?   @db.ObjectId // (ID chân hụi trúng)
  bidAmount            Float     @default(0) // Giá bỏ thăm trúng
  winnerReceivedAmount Float     @default(0) // Thực nhận
  status               String    @default("BIDDING") // SessionStatus: BIDDING, TIE_BREAKER, DONE
  tieBreakerData       Json?     // Dữ liệu bốc thăm may mắn
  payments             Payment[]
  bids                 Bid[]
}

model Bid {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  sessionId     String     @db.ObjectId
  session       HuiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId        String     @db.ObjectId
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  huiMemberId   String?    @db.ObjectId
  huiMember     HuiMember? @relation(fields: [huiMemberId], references: [id], onDelete: Cascade)
  amount        Float      // Số tiền kêu
  isWhiteTicket Boolean    @default(false) // Phiếu trắng (không kêu)
  tieBreakerNum Int?       // Số điểm bốc thăm được nếu bị rơi vào vòng Tie-breaker
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt @default(now()) // Dùng cho check 2 tiếng sửa phiếu

  @@unique([sessionId, huiMemberId]) // 1 chân hụi chỉ bỏ 1 phiếu trong 1 kỳ
}

model Payment {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  sessionId   String     @db.ObjectId
  session     HuiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  huiMemberId String?    @db.ObjectId
  huiMember   HuiMember? @relation(fields: [huiMemberId], references: [id], onDelete: Cascade)
  isDead      Boolean    @default(false) // Hụi chết/sống
  amountToPay Float
  paidStatus  String     @default("UNPAID") // PaidStatus: UNPAID, PAID
  paidAt      DateTime?
}

model SystemSetting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}

model TransferHistory {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  huiGroupId    String   @db.ObjectId
  huiGroup      HuiGroup @relation(fields: [huiGroupId], references: [id], onDelete: Cascade)
  fromUserId    String   @db.ObjectId
  fromUser      User     @relation("FromUser", fields: [fromUserId], references: [id])
  toUserId      String   @db.ObjectId
  toUser        User     @relation("ToUser", fields: [toUserId], references: [id])
  memberId      String   @db.ObjectId
  sessionNumber Int?
  transferDate  DateTime @default(now())
}
